# Copie ce fichier en `.env.local` (jamais commité) et remplis les valeurs
# récupérées dans Supabase > Project Settings > API.

# URL du projet Supabase (Project Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (Project Settings > API > Project API keys > anon public)
# Peut être exposée côté navigateur : la sécurité vient de la RLS, pas du secret de cette clé.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé "service_role" (Project Settings > API > Project API keys > service_role)
# SECRÈTE : ne jamais préfixer par NEXT_PUBLIC_, ne jamais l'exposer côté navigateur.
# Utilisée uniquement côté serveur par la tâche planifiée (cron) qui génère les
# transactions d'abonnement, car cette tâche s'exécute sans session utilisateur.
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé pour vérifier que l'appel à /api/cron/* vient bien de Vercel Cron
# et pas d'un appelant externe. Génère une valeur aléatoire, ex: `openssl rand -hex 32`.
CRON_SECRET=

# ---------------------------------------------------------------------------
# Emails (étape 6.2) — envoi par Resend (resend.com)
#
# Les trois sont SECRETS ou internes : jamais de préfixe NEXT_PUBLIC_.
# Si l'une manque, les messages du support sont quand même enregistrés et
# visibles dans /admin ; seule la notification par email ne part pas.
# ---------------------------------------------------------------------------

# Clé d'API Resend (Resend > API Keys). Donne-lui le droit « Sending access »
# seulement, pas « Full access » : si elle fuite, elle ne permet que d'envoyer.
RESEND_API_KEY=

# Expéditeur des emails. Tant que le domaine notif.tcif-pro.fr n'est pas vérifié
# chez Resend, utiliser l'adresse de test de Resend — elle n'écrit qu'à
# l'adresse du compte Resend, ce qui suffit pour tester le support :
#   EMAIL_FROM="TCIF <onboarding@resend.dev>"
# Une fois le domaine vérifié :
#   EMAIL_FROM="TCIF <no-reply@notif.tcif-pro.fr>"
EMAIL_FROM=

# Boîte qui reçoit les notifications des messages du support.
SUPPORT_EMAIL_TO=

# Notifications push (Réglages → Alertes → Notifications sur cet appareil).
# Une paire de clés VAPID par environnement, générée avec :
#   npx web-push generate-vapid-keys
# La clé publique est lue par le navigateur (d'où le préfixe NEXT_PUBLIC_) ;
# la clé privée signe les envois, elle ne quitte jamais le serveur.
# Sans elles, le bloc « Notifications » indique qu'elles ne sont pas
# configurées et les alertes partent par email.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contact@tcif-pro.fr

# Inscription en libre-service (V3, phase 2).
# Captcha Cloudflare Turnstile : clé de site (publique) et clé secrète, une
# paire par environnement (Cloudflare → Turnstile → Add widget).
# Clés de TEST officielles de Cloudflare, pour le développement :
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA  (toujours validé)
#   TURNSTILE_SECRET_KEY=2x0000000000000000000000000000000AA  (toujours refusé)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Abonnement payant par prélèvement SEPA (V3, phase 3), via GoCardless.
# Sans jeton, rien de l'abonnement n'apparaît dans l'app.
# GOCARDLESS_ENVIRONMENT : « sandbox » (défaut, argent fictif) ou « live ».
# Jeton : dashboard GoCardless → Developers → Create → Access token (Read-write).
# Secret : Developers → Create → Webhook endpoint, adresse
#   https://<app>/api/webhooks/gocardless
GOCARDLESS_ENVIRONMENT=sandbox
GOCARDLESS_ACCESS_TOKEN=
GOCARDLESS_WEBHOOK_SECRET=

# Interrupteur : « true » ouvre les inscriptions. Tant qu'il est absent ou à
# autre chose, /inscription annonce l'ouverture prochaine et le serveur
# refuse toute création de compte.
INSCRIPTIONS_OUVERTES=

# Hors production seulement (Preview, local) : adresses qui reçoivent quand
# même les emails directement, sans redirection ni « [TEST → …] », pour
# vérifier qu'un email arrive bien (séparées par des virgules ; « +essai »
# accepté). Toutes les autres partent vers SUPPORT_EMAIL_TO. En production,
# cette variable n'a AUCUN effet : tout part vers le vrai destinataire.
EMAILS_TEST_AUTORISES=
